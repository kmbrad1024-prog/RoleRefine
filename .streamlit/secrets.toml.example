# Copy this file to .streamlit/secrets.toml for local use (it's git-ignored).
# On Streamlit Community Cloud, paste these into App settings → Secrets instead.

# Free option: a Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY = "AQ...."   # older Gemini keys start with "AIza"; both work

# Optional: an Anthropic key, used instead if PROVIDER = "anthropic"
# ANTHROPIC_API_KEY = "sk-ant-..."

# Optional overrides
# PROVIDER = "gemini"            # or "anthropic"
# MODEL = "gemini-3.5-flash"     # or e.g. "claude-sonnet-5"
